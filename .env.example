# Supabase Configuration
# Get these from: https://supabase.com/dashboard/project/_/settings/api
# 1. Create a new project on Supabase
# 2. Copy your project URL and anon key from Settings > API
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Supabase Service Role Key
# WARNING: NEVER expose this in client-side code - server-side only!
# This key bypasses Row Level Security and has full database access
# Only use in API routes, server components, and admin scripts
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Gemini API key for AI Brief Builder (optional)
# Get it from: https://aistudio.google.com/app/apikey
# The app works without this key — it uses smart rule-based fallback
GEMINI_API_KEY=your_gemini_api_key_here

# Base URL for your deployment
# Local: http://localhost:3000
# Production: https://your-app.onrender.com
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Node Environment
NODE_ENV=development
