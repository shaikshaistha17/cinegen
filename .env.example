# ============================================================================
# CineGen Environment Variables
# Copy this file to .env.local and fill in your actual values
# NEVER commit .env.local to version control
# ============================================================================

# Supabase Configuration
# Get these from: https://supabase.com/dashboard/project/_/settings/api
# 1. Create a new project on Supabase
# 2. Copy your project URL and anon key from Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# Supabase Service Role Key
# WARNING: NEVER expose this in client-side code or commit to Git!
# This key bypasses Row Level Security and has full database access
# Only use in API routes, server components, and admin scripts
# Get from: https://supabase.com/dashboard/project/_/settings/api
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key-here

# Gemini API key for AI Brief Builder (OPTIONAL)
# Get it from: https://aistudio.google.com/app/apikey
# The app works without this key — it uses smart rule-based fallback
GEMINI_API_KEY=AIzaSy_your_gemini_api_key_here

# Base URL for your deployment
# Local development: http://localhost:3000
# Production: https://your-app.onrender.com
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Node Environment
# Use "development" for local, "production" for deployed
NODE_ENV=development

# ============================================================================
# Email Configuration (OPTIONAL - Configure in Supabase Dashboard)
# ============================================================================
# By default, Supabase sends password reset and verification emails
# using its built-in email service.
#
# For production with custom branding:
# 1. Go to Supabase Dashboard > Authentication > Email Templates
# 2. Configure SMTP settings there (not in this file)
# 3. Customize email templates
#
# Example settings to configure in Supabase (DO NOT add here):
# - SMTP Host: smtp.gmail.com
# - SMTP Port: 587  
# - SMTP User: your-email@gmail.com
# - SMTP Password: your-app-password
# - From Email: noreply@cinegen.ai
# ============================================================================

# ============================================================================
# SECURITY REMINDERS
# ============================================================================
# ✅ Never commit .env.local to Git
# ✅ Rotate all secrets if they are exposed
# ✅ Use different credentials for development and production
# ✅ Service role key should NEVER be in NEXT_PUBLIC_ variables
# ✅ Anon key is safe for client-side (RLS protects data)
# ============================================================================
